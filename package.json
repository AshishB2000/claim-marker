{
  "name": "claim-marker",
  "version": "0.1.0",
  "description": "Embeddable 3D vehicle damage marker for insurance claims",
  "license": "MIT",
  "type": "module",
  "main": "./dist/claim-marker.js",
  "module": "./dist/claim-marker.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/claim-marker.js"
    }
