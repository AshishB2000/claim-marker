# The claim server's settings (server/claim-server.mjs). Copy to .env, which git ignores:
#
#   docker compose up --build                         # reads .env for its ${…}
#   node --env-file=.env server/claim-server.mjs      # after npm run build
#
# On Fly these are `fly secrets set` and fly.toml's [env]; on Render, render.yaml.
# Secrets are blank on purpose: make them with `openssl rand -hex 32`.

# refuse to start without a customer token or session secret, DESK_TOKEN, and a CLAIM_ORIGIN that is not *
NODE_ENV=production
# the port it listens on
PORT=8788
# where reports are filed, one folder each
CLAIM_DIR=./data/claims
# the built page; defaults to dist/ beside server/
STATIC_DIR=
# a shared bearer token the page sends; unset together with SESSION_SECRET, anyone may post
CLAIM_TOKEN=
# the HMAC key for per-customer session tokens minted by POST /sessions
SESSION_SECRET=
# the key your backend sends as x-api-key to POST /sessions
API_KEY=
# what the claims desk sends to read and re-file reports
DESK_TOKEN=
# origins allowed to embed the page, comma-separated; sets frame-ancestors and the page's trust list
ALLOWED_HOSTS=
# the insurer's name, shown under the page title
BRAND=

# en or es — fixes the page's language and hides its switch; unset, the customer chooses
LANG_DEFAULT=
# an endpoint speaking claim-assist/1; unset, no AI exists in the page
ASSIST_URL=
# extra origins the page may reach (your own tiles or geocoder), comma-separated, added to the CSP
CONNECT_SRC=
# POSTs per minute per IP
RATE_LIMIT=30
# 1 when a proxy in front sets Fly-Client-IP or X-Forwarded-For
TRUST_PROXY=
# where new reports are announced
WEBHOOK_URL=
# the HMAC key for the webhook's X-Claim-Signature
WEBHOOK_SECRET=
# an extra origin for CORS; leave unset in production, the page served from here needs none
CLAIM_ORIGIN=
# forget reports older than this many days; unset keeps them for ever
RETAIN_DAYS=7
# 1 serves the demo insurer portal at /demo/ and keeps what it files for a day; never on an instance taking real claims
DEMO=
